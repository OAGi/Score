# Copy to deploy/deploy.env (git-ignored) and fill in your environment-specific values.
# These are read by deploy/config.sh. Do NOT commit deploy.env.

# AWS security group + rule ids that gate SSH (22) + DB (3306) ingress to your IP.
# Find them in the EC2 console (Security Groups) or via:
#   aws ec2 describe-security-groups --filters Name=group-name,Values=<name> --query 'SecurityGroups[].GroupId'
#   aws ec2 describe-security-group-rules --filter Name=group-id,Values=<sg-id>
SG_ID="sg-xxxxxxxxxxxxxxxxx"
SG_RULE_IDS="sgr-xxxxxxxxxxxxxxxxx sgr-yyyyyyyyyyyyyyyyy"
AWS_REGION="us-east-2"

# DB / dump settings (needed by backup-dbs.sh and regen-repo-image.sh).
# MYSQLDUMP must be a MySQL 8 mysqldump (needed for --column-statistics=0 against MariaDB),
# e.g. MySQL Workbench's bundled binary.
DUMPS_DIR="$HOME/dumps"
MYSQLDUMP="/path/to/mysqldump"
DB_USER="your-db-user"
DB_PASS="your-db-password"
DB_NAME="your-db-name"
DB_PORT="3306"

# SSH private key used to reach the fleet instances.
SSH_KEY="$HOME/.ssh/your-key.pem"